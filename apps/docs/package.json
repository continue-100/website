{
  "name": "docs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"velite dev\" \"next dev --port 3001\"",
    "build": "pnpm velite && next build",
    "build:content": "pnpm velite",
    "audit:content": "node scripts/audit-content.mjs",
    "verify:examples": "node scripts/verify-doc-examples.mjs",
    "check": "pnpm velite && pnpm audit:content && pnpm verify:examples && eslint .",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@heroui/react": "3.1.0",
    "@heroui/styles": "3.1.0",
    "@prismio/docs-core": "workspace:*",
    "@prismio/ui": "workspace:*",
    "@prismio/utils": "workspace:*",
    "@vinext/cloudflare": "^1.0.1",
    "concurrently": "^9.2.1",
    "framer-motion": "^12.40.0",
    "github-slugger": "2.0.0",
    "hamburger-react": "^2.5.2",
    "lucide-react": "0.562.0",
    "marked": "17.0.1",
    "mitt": "3.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.3.0",
    "shiki": "^3.21.0",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@prismio/eslint-config": "workspace:*",
    "@prismio/typescript-config": "workspace:*",
    "@shikijs/rehype": "^3.21.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "babel-plugin-react-compiler": "1.0.0",
    "cf": "1.0.0-beta.11",
    "eslint": "10.9.1",
    "tailwindcss": "^4.3.0",
    "typescript": "7.0.2",
    "velite": "^0.3.1",
    "vite": "8.3.0"
  }
}
